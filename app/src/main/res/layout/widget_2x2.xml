<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_small"
    android:orientation="vertical"
    android:paddingLeft="14dp"
    android:paddingTop="12dp"
    android:paddingRight="14dp"
    android:paddingBottom="13dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widgetName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.01"
            android:singleLine="true"
            android:text="海豹 06"
            android:textColor="@color/text"
            android:textSize="12sp" />

        <!-- RemoteViews 不支持 <View>，圆点必须用 ImageView -->
        <ImageView
            android:id="@+id/widgetDot"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_marginLeft="8dp"
            android:background="@drawable/dot_dim" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/wSlot1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginRight="8dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_primary"
            android:padding="13dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_unlock"
            android:tint="@color/btn_text" />

        <ImageView
            android:id="@+id/wSlot2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_btn"
            android:padding="13dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_lock"
            android:tint="@color/text" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/wSlot3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginRight="8dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn"
            android:padding="13dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_power"
            android:tint="@color/text" />

        <ImageView
            android:id="@+id/wSlot4"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_btn"
            android:padding="13dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_trunk"
            android:tint="@color/text" />
    </LinearLayout>
</LinearLayout>
