<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <com.zjy.bydmini.GlowView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="22dp"
            android:paddingTop="38dp"
            android:paddingRight="22dp"
            android:paddingBottom="32dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnBack"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/sub_action_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingLeft="13dp"
                    android:paddingTop="7dp"
                    android:paddingRight="13dp"
                    android:paddingBottom="7dp"
                    android:text="返回"
                    android:textColor="@color/text"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="14dp"
                    android:layout_weight="1"
                    android:text="设置"
                    android:textColor="@color/text"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:layout_marginLeft="3dp"
                android:letterSpacing="0.12"
                android:text="外观"
                android:textColor="@color/text_dim"
                android:textSize="11sp" />

            <LinearLayout
                android:id="@+id/lookBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/glass_panel"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginLeft="3dp"
                android:lineSpacingExtra="3dp"
                android:text="桌面名字和图标就在这里选。名字想完全自定义的话，在桌面上长按图标 → 重命名 即可。"
                android:textColor="@color/text_dim"
                android:textSize="11sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:layout_marginLeft="3dp"
                android:letterSpacing="0.12"
                android:text="车辆"
                android:textColor="@color/text_dim"
                android:textSize="11sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginLeft="3dp"
                android:text="名字"
                android:textColor="@color/text_dim"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/nameIn"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/field_bg"
                android:hint="海豹 06"
                android:inputType="text"
                android:maxLines="1"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:singleLine="true"
                android:textColor="@color/text"
                android:textColorHint="@color/text_dim"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="3dp"
                        android:text="电量 %"
                        android:textColor="@color/text_dim"
                        android:textSize="12sp" />

                    <EditText
                        android:id="@+id/pctIn"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/field_bg"
                        android:hint="82"
                        android:inputType="number"
                        android:maxLines="1"
                        android:paddingLeft="14dp"
                        android:singleLine="true"
                        android:textColor="@color/text"
                        android:textColorHint="@color/text_dim"
                        android:textSize="15sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="3dp"
                        android:text="续航 km"
                        android:textColor="@color/text_dim"
                        android:textSize="12sp" />

                    <EditText
                        android:id="@+id/rangeIn"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/field_bg"
                        android:hint="412"
                        android:inputType="number"
                        android:maxLines="1"
                        android:paddingLeft="14dp"
                        android:singleLine="true"
                        android:textColor="@color/text"
                        android:textColorHint="@color/text_dim"
                        android:textSize="15sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:layout_marginLeft="3dp"
                android:letterSpacing="0.12"
                android:text="功能按钮"
                android:textColor="@color/text_dim"
                android:textSize="11sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginLeft="3dp"
                android:text="软件里的 4 个格子"
                android:textColor="@color/text_dim"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/appSlotBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/glass_panel"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:layout_marginLeft="3dp"
                android:text="小部件（4 × 2 用 5 个，2 × 2 用前 4 个）"
                android:textColor="@color/text_dim"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/widgetSlotBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/glass_panel"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnNewAction"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:background="@drawable/sub_action_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="新建自定义动作"
                    android:textColor="@color/text"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/btnManageAction"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_marginLeft="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/sub_action_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="管理自定义动作"
                    android:textColor="@color/text"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginLeft="3dp"
                android:lineSpacingExtra="3dp"
                android:text="自定义动作 = 填官方 App 里那个按钮上的文字，点一次就自动跳过去按它。多个写法用逗号隔开，比如「后备箱,尾门」。"
                android:textColor="@color/text_dim"
                android:textSize="11sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:layout_marginLeft="3dp"
                android:letterSpacing="0.12"
                android:text="主图"
                android:textColor="@color/text_dim"
                android:textSize="11sp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="196dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/glass_panel">

                <ImageView
                    android:id="@+id/preview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="10dp"
                    android:scaleType="fitCenter" />

                <TextView
                    android:id="@+id/previewHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="还没有主图\n默认显示概念车"
                    android:textColor="@color/text_dim"
                    android:textSize="12sp" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnPick"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:background="@drawable/sub_action_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="选图片"
                    android:textColor="@color/text"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/btnReset"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_marginLeft="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/sub_action_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="恢复默认"
                    android:textColor="@color/text"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="自动抠图"
                    android:textColor="@color/text"
                    android:textSize="13sp" />

                <CheckBox
                    android:id="@+id/cutSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true" />
            </LinearLayout>

            <TextView
                android:id="@+id/tolLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginLeft="3dp"
                android:text="抠图强度 24"
                android:textColor="@color/text_dim"
                android:textSize="12sp" />

            <SeekBar
                android:id="@+id/tolBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:max="70"
                android:progress="22" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginLeft="3dp"
                android:lineSpacingExtra="3dp"
                android:text="底色越干净、强度越小；抠不干净就往上调，糊到车身上就往回降。"
                android:textColor="@color/text_dim"
                android:textSize="11sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:layout_marginLeft="3dp"
                android:letterSpacing="0.12"
                android:text="桌面小部件"
                android:textColor="@color/text_dim"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnPin2"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_marginRight="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/sub_action_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif"
                    android:gravity="center"
                    android:letterSpacing="0.06"
                    android:text="2 × 2 加到桌面"
                    android:textColor="@color/text"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/btnPin4"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:background="@drawable/sub_action_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif"
                    android:gravity="center"
                    android:letterSpacing="0.06"
                    android:text="4 × 2 加到桌面"
                    android:textColor="@color/text"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginLeft="3dp"
                android:text="不弹窗就直接长按桌面空白处 → 小部件 → Car"
                android:textColor="@color/text_dim"
                android:textSize="11sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:layout_marginLeft="3dp"
                android:letterSpacing="0.12"
                android:text="排查"
                android:textColor="@color/text_dim"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/btnDiag"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/sub_action_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="抓取官方界面结构"
                android:textColor="@color/text"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginLeft="3dp"
                android:lineSpacingExtra="3dp"
                android:text="某个动作点了没反应时用：会跳到官方 App 车控页，把界面结构复制到剪贴板，粘贴出来就能看出按钮到底叫什么。"
                android:textColor="@color/text_dim"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/btnSave"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/btn_primary"
                android:clickable="true"
                android:elevation="12dp"
                android:focusable="true"
                android:gravity="center"
                android:letterSpacing="0.08"
                android:text="保 存"
                android:textColor="@color/btn_text"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
