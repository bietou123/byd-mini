<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <com.zjy.bydmini.GlowView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingLeft="22dp"
        android:paddingRight="22dp"
        android:paddingTop="42dp"
        android:paddingBottom="30dp">

        <LinearLayout
            android:id="@+id/headerRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/carName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0"
                    android:text="海豹 06"
                    android:textColor="@color/text"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/batteryText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="sans-serif"
                    android:letterSpacing="0.02"
                    android:text="82%   ·   续航 412 km"
                    android:textColor="@color/text_dim"
                    android:textSize="12sp" />
            </LinearLayout>

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <View
                android:id="@+id/statusDot"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@drawable/dot_dim" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="7dp"
                android:fontFamily="sans-serif"
                android:letterSpacing="0.02"
                android:text="未连接"
                android:textColor="@color/text_dim"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/btnSettings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:background="@drawable/sub_action_bg"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif"
                android:paddingLeft="11dp"
                android:paddingTop="6dp"
                android:paddingRight="11dp"
                android:paddingBottom="7dp"
                android:text="设置"
                android:textColor="@color/text"
                android:textSize="12sp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/carArea"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <com.zjy.bydmini.CarView
                android:id="@+id/carView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/bottomPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="48dp"
            android:background="@drawable/glass_panel"
            android:orientation="vertical"
            android:padding="9dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/cell1"
                    style="@style/ActionCellPrimary"
                    android:layout_marginRight="8dp">

                    <ImageView
                        android:id="@+id/cellIcon1"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_unlock"
                        android:tint="@color/btn_text" />

                    <TextView
                        android:id="@+id/cellLabel1"
                        style="@style/ActionLabel"
                        android:textColor="@color/btn_text" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/cell2"
                    style="@style/ActionCell">

                    <ImageView
                        android:id="@+id/cellIcon2"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_lock"
                        android:tint="@color/text" />

                    <TextView
                        android:id="@+id/cellLabel2"
                        style="@style/ActionLabel" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/cell3"
                    style="@style/ActionCell"
                    android:layout_marginRight="8dp">

                    <ImageView
                        android:id="@+id/cellIcon3"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_power"
                        android:tint="@color/text" />

                    <TextView
                        android:id="@+id/cellLabel3"
                        style="@style/ActionLabel" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/cell4"
                    style="@style/ActionCell">

                    <ImageView
                        android:id="@+id/cellIcon4"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_trunk"
                        android:tint="@color/text" />

                    <TextView
                        android:id="@+id/cellLabel4"
                        style="@style/ActionLabel" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
