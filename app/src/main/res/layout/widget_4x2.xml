<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:paddingLeft="14dp"
    android:paddingTop="13dp"
    android:paddingRight="14dp"
    android:paddingBottom="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="18dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widgetName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.01"
            android:singleLine="true"
            android:text="海豹 06"
            android:textColor="@color/text"
            android:textSize="12sp" />

        <!-- RemoteViews 不支持 <View>，圆点必须用 ImageView -->
        <ImageView
            android:id="@+id/widgetDot"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_marginLeft="8dp"
            android:background="@drawable/dot_dim" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1.32"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/wSlot1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginRight="8dp"
            android:layout_weight="1.24"
            android:background="@drawable/widget_btn_primary"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:letterSpacing="0.02"
            android:singleLine="true"
            android:text="解锁"
            android:textColor="@color/btn_text"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/wSlot2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_btn"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:letterSpacing="0.02"
            android:singleLine="true"
            android:text="上锁"
            android:textColor="@color/text"
            android:textSize="17sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/wSlot3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginRight="8dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:singleLine="true"
            android:text="空调"
            android:textColor="@color/text"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/wSlot4"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginRight="8dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:singleLine="true"
            android:text="熄火"
            android:textColor="@color/text"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/wSlot5"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_btn"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:singleLine="true"
            android:text="后备箱"
            android:textColor="@color/text"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
