<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/w_glass_fill_press" />
            <stroke
                android:width="1dp"
                android:color="@color/w_glass_rim" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#00FFFFFF"
                android:startColor="@color/w_glass_sheen" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</layer-list>
